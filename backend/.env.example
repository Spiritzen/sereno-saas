# Copie ce fichier en `.env` (jamais commité — voir .gitignore) et
# remplace les placeholders par de vraies valeurs.
#
# Génère un jeu de clés valide avec :
#   bin/rails db:encryption:init
# La commande imprime 3 valeurs (primary_key / deterministic_key /
# key_derivation_salt) : colle-les ci-dessous, une par variable. Ne les mets
# JAMAIS dans config/credentials.yml.enc (décision B5 : ces clés vivent en
# ENV, pour rester alignées avec l'injection de secrets Kamal en prod).
#
# Utilisées en développement ET en test (le même .env sert aux deux, sauf si
# tu crées un .env.test dédié — voir config/boot.rb pour l'ordre de chargement).

SERENO_AR_ENCRYPTION_PRIMARY_KEY=<générer via bin/rails db:encryption:init>
SERENO_AR_ENCRYPTION_DETERMINISTIC_KEY=<générer via bin/rails db:encryption:init>
SERENO_AR_ENCRYPTION_KEY_DERIVATION_SALT=<générer via bin/rails db:encryption:init>

# Déjà utilisée par config/database.yml — rappel, pas une nouveauté B5.
SERENO_DATABASE_PASSWORD=<mot de passe local de ta base PostgreSQL>
